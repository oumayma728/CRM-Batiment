# --- Clés API (à ne jamais committer, copier ce fichier vers .env) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Mapping modalité -> provider/modèle ---
# Valeurs par défaut = candidats de benchmark nommés dans le CDC (section 3.2).
# À remplacer par la stack réellement retenue après la Phase 1 (benchmark).
TEXTE_PROVIDER=openai
TEXTE_MODEL=gpt-4o-mini

VISION_PROVIDER=anthropic
VISION_MODEL=claude-3-7-sonnet-20250219

TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=whisper-1

# --- Fallback (optionnel) ---
# Exemple donné dans le CDC : "si GPT-4o-mini timeout -> Claude Haiku"
TEXTE_FALLBACK_PROVIDER=anthropic
TEXTE_FALLBACK_MODEL=claude-3-5-haiku-20241022

VISION_FALLBACK_PROVIDER=google
VISION_FALLBACK_MODEL=gemini-2.0-flash

# --- Timeout commun (secondes) ---
TOOLREGISTRY_TIMEOUT_SECONDS=30
