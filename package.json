{
  "name": "crm-batiment",
  "private": true,
  "type": "module",
  "scripts": {
    "install:apps": "npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n backend,frontend \"npm --prefix backend run start:dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4.22.4"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.101.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.18.0",
    "prisma": "^6.19.3"
  }
}
