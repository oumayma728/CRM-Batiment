# Copiez ce fichier en .env et renseignez au moins MISTRAL_API_KEY
# (provider principal sur les 3 modalites : texte, vision, transcription).
# Les autres cles sont optionnelles -- utilisees uniquement par les
# fallbacks/benchmarks (cf. toolregistry/config.py).

MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Overrides optionnels du modele actif par modalite (format "provider:model_name").
# Sans ces variables, la config par defaut de toolregistry/config.py est utilisee.
# TEXTE_MODEL=mistral:mistral-small-latest
# VISION_MODEL=mistral:pixtral-12b-2409
# VOCAL_MODEL=mistral_voxtral:voxtral-mini-latest
