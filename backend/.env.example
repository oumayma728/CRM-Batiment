# Application

APP_ENV=development

APP_PORT=3000

APP_URL=http://localhost:5173



# JWT

JWT_SECRET=changez_moi_en_production

JWT_EXPIRES_IN=8h



# Base de donnees

DATABASE_URL=postgresql://user:password@localhost:5432/crm_batiment



# Email (SMTP) — requis pour recevoir les vrais emails

# Sans cette config, les mots de passe temporaires sont affiches

# sur la page de login (dev) et dans la console backend.

#

# Gmail (mot de passe d'application requis) :

# 1. Activez la validation en 2 etapes sur votre compte Google

# 2. Creez un mot de passe d'application : https://myaccount.google.com/apppasswords

# 3. Renseignez MAIL_USER et MAIL_PASS ci-dessous

MAIL_HOST=smtp.gmail.com

MAIL_PORT=587

MAIL_USER=votre.email@gmail.com

MAIL_PASS=xxxx xxxx xxxx xxxx

MAIL_FROM="CRM Batiment" <votre.email@gmail.com>

#

# Outlook / Office 365 :

# MAIL_HOST=smtp.office365.com

# MAIL_PORT=587

# MAIL_USER=votre.email@outlook.com

# MAIL_PASS=votre_mot_de_passe

# MAIL_FROM="CRM Batiment" <votre.email@outlook.com>

#

# Alternative dev (boite mail de test, pas de vraie reception) :

# MAIL_USE_ETHEREAL=true

