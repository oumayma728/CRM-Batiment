# Backend environment variables for CRM Batiment
# Copy this file to .env and replace the placeholder values.

APP_ENV=development
NODE_ENV=development
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://user:password@localhost:5432/crm_batiment
JWT_SECRET=change-me-to-a-long-random-secret

# SMTP configuration for real email sending
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-smtp-user
MAIL_PASS=your-smtp-password
MAIL_FROM="CRM Batiment" <noreply@crm-batiment.fr>
